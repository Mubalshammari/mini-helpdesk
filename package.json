{
  "name": "mini-helpdesk",
  "private": true,
  "version": "1.0.0",
  "description": "Security-first internal IT support ticketing system - one React + Supabase codebase for web and Windows desktop, with every access rule enforced in Postgres.",
  "author": "Mubarak Alshammari",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"vite\" \"wait-on tcp:6234 && cross-env VITE_DEV_SERVER_URL=http://localhost:6234 electron .\"",
    "build": "vite build",
    "build:web": "vite build",
    "build:desktop": "npm run icon && cross-env BUILD_TARGET=desktop vite build && electron-builder --win",
    "preview": "vite preview",
    "icon": "node scripts/generate-icon.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.2",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.minihelpdesk.desktop",
    "productName": "Mini Helpdesk",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mini Helpdesk",
      "menuCategory": "Mini Helpdesk",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "Mini Helpdesk ${version}",
      "artifactName": "Mini-Helpdesk-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Mini-Helpdesk-Portable-${version}.${ext}"
    }
  }
}
