# Copy this file to .env and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard).
#
# VITE_SUPABASE_ANON_KEY is the public "anon" key — safe to ship to the
# browser AND to the bundled desktop app, because every table it can touch
# is locked down by Row-Level Security (see supabase/migrations/). NEVER put
# the service_role key here or anywhere in client code: it bypasses RLS.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Desktop app (Electron) only, both optional ---------------------------
# APP_MODE controls what the desktop window loads:
#   local  (default) - the bundled build; a real offline-capable installed app
#   remote           - the deployed URL below, always showing the latest deploy
# APP_REMOTE_URL is the deployed site the desktop app loads in remote mode.
# These are read by the Electron main process at runtime, not bundled by Vite,
# so they are NOT prefixed with VITE_.
# APP_MODE=local
# APP_REMOTE_URL=https://mini-helpdesk.netlify.app
